# ── Applink (server-side only — never prefix with NEXT_PUBLIC_) ──────────────
# From the Applink developer portal once the app is approved.
APPLINK_APP_ID=APP_XXXXXX
APPLINK_PASSWORD=

# One URL per provisioned service. Leave unset if the API isn't enabled.
# Live:
#   APPLINK_OTP_REQUEST_URL=https://api.applink.com.bd/otp/request
#   APPLINK_OTP_VERIFY_URL=https://api.applink.com.bd/otp/verify
# Local mock (code is always 123456):
APPLINK_OTP_REQUEST_URL=http://localhost:3000/api/dev/applink/otp/request
APPLINK_OTP_VERIFY_URL=http://localhost:3000/api/dev/applink/otp/verify

# 1 = enable the built-in OTP mock at /api/dev/applink/* (ignored in production)
APPLINK_DEV_MOCK=1

# What the subscriber is told before OTP (Applink OTP verify activates the
# app's subscription). Must match the charge set on the Applink app.
BOIO_SUB_CHARGE_BDT=0
BOIO_SUB_FREQUENCY=monthly

# ── Sessions ────────────────────────────────────────────────────────────────
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
